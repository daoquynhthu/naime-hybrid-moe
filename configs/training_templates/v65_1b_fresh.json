{
  "description": "V6.5 1B-token fresh training on FineWeb-Edu 1B, 100M-class model with latent thought and field coupling.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${remote.datasets}/fineweb_edu_1b_ctx1024",
    "OutputDir": "${remote.runs}",
    "TargetTokens": 1000000000,
    "TargetTokensMode": "total",
    "SeqLen": 1024,
    "BatchSize": 6,
    "DModel": 768,
    "Layers": 12,
    "DenseLayers": 2,
    "Heads": 12,
    "KvHeads": 4,
    "Dff": 3072,
    "Dropout": 0.05,
    "Experts": 6,
    "TopK": 2,
    "ExpertHidden": 1536,
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 192,
    "WorldStateSlots": 6,
    "SelfStateSlots": 6,
    "SemanticStateWriteScale": 0.075,
    "WorldRouterMaxRatio": 0.08,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "LatentThoughtSteps": 1,
    "LatentThoughtWriteMode": "final_hidden",
    "LatentThoughtHiddenScale": 0.02,
    "LatentFieldCoupling": true,
    "EvalStateCarry": true,
    "EvalLatentThoughtGain": true,
    "CompileModel": true,
    "CompileScope": "dense",
    "CompileBackend": "inductor",
    "VramFraction": 0.90,
    "AutoBatchMax": 64,
    "NumWorkers": 4,
    "LearningRate": 0.00003,
    "WarmupSteps": 1000,
    "MinLrRatio": 0.08,
    "GradClip": 0.5,
    "WeightDecay": 0.08,
    "SaveEvery": 10000,
    "LatestEvery": 5000,
    "KeepLastN": 2,
    "EvalEvery": 5000,
    "EvalMaxBatches": 40,
    "Resume": "none",
    "ResumeLrPolicy": "reset",
    "StopCheckEvery": 10
  }
}
