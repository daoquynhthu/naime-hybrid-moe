{
  "description": "Remote V6 partial torch.compile smoke run. Compiles only dense Transformer blocks and keeps V6 state/MoE/self-recursion eager.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${remote.datasets}/fineweb_edu_50m",
    "OutputDir": "${remote.runs}",
    "TargetTokens": 20480,
    "TargetTokensMode": "total",
    "SeqLen": 128,
    "BatchSize": 2,
    "DModel": 128,
    "Layers": 4,
    "DenseLayers": 2,
    "Heads": 4,
    "KvHeads": 2,
    "Dff": 256,
    "Dropout": 0.05,
    "Experts": 2,
    "TopK": 1,
    "ExpertHidden": 256,
    "Stride": 8,
    "CausalStateStride": 128,
    "Window": 12,
    "ZDim": 32,
    "WorldStateSlots": 2,
    "SelfStateSlots": 2,
    "SemanticStateWriteScale": 0.075,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "NoAutoBatch": true,
    "NumWorkers": 0,
    "LearningRate": 0.0001,
    "WarmupSteps": 20,
    "MinLrRatio": 0.05,
    "GradClip": 1.0,
    "WeightDecay": 0.05,
    "SaveEvery": 0,
    "LatestEvery": 0,
    "EvalEvery": 50,
    "EvalMaxBatches": 2,
    "CompileModel": true,
    "CompileScope": "dense",
    "CompileBackend": "inductor",
    "Resume": "none"
  }
}
