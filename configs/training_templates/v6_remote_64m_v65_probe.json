{
  "description": "Remote 64M-class V6.5 probe for validating native state carry and state-only latent thought on a 4090-class GPU.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${remote.datasets}/fineweb_edu_50m",
    "OutputDir": "${remote.runs}",
    "TargetTokens": 20000000,
    "TargetTokensMode": "total",
    "SeqLen": 1024,
    "BatchSize": 4,
    "DModel": 640,
    "Layers": 10,
    "DenseLayers": 2,
    "Heads": 10,
    "KvHeads": 2,
    "Dff": 2560,
    "Dropout": 0.05,
    "Experts": 6,
    "TopK": 2,
    "ExpertHidden": 1280,
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 160,
    "WorldStateSlots": 6,
    "SelfStateSlots": 6,
    "SemanticStateWriteScale": 0.075,
    "WorldRouterMaxRatio": 0.08,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "LatentThoughtSteps": 1,
    "LatentThoughtWriteMode": "state_only",
    "LatentThoughtHiddenScale": 0.0,
    "LatentFieldCoupling": false,
    "LatentFieldTokenScale": 0.0,
    "LatentFieldMaxRatio": 0.0,
    "VramFraction": 0.80,
    "AutoBatchMax": 32,
    "NumWorkers": 4,
    "LearningRate": 0.00004,
    "WarmupSteps": 600,
    "MinLrRatio": 0.05,
    "GradClip": 1.0,
    "WeightDecay": 0.06,
    "SaveEvery": 5000,
    "LatestEvery": 2500,
    "KeepLastN": 2,
    "EvalEvery": 1000,
    "EvalMaxBatches": 20,
    "EvalStateCarry": true,
    "EvalLatentThoughtGain": true,
    "CompileModel": true,
    "CompileScope": "dense",
    "Resume": "none",
    "ResumeLrPolicy": "reset",
    "StopCheckEvery": 10,
    "MaxSteps": 1000
  }
}
