{
  "description": "Remote 100M-class V6 continuation chunk. Use with an explicit clean Resume path.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${remote.datasets}/fineweb_edu_1b_ctx1024",
    "OutputDir": "${remote.runs}",
    "TargetTokens": 100000000,
    "TargetTokensMode": "additional",
    "SeqLen": 1024,
    "BatchSize": 6,
    "DModel": 768,
    "Layers": 12,
    "DenseLayers": 2,
    "Heads": 12,
    "KvHeads": 4,
    "Dff": 3072,
    "Dropout": 0.08,
    "Experts": 6,
    "TopK": 2,
    "ExpertHidden": 1536,
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 192,
    "WorldStateSlots": 6,
    "SelfStateSlots": 6,
    "SemanticStateWriteScale": 0.075,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "VramFraction": 0.80,
    "AutoBatchMax": 64,
    "NumWorkers": 4,
    "LearningRate": 0.000006,
    "WarmupSteps": 500,
    "MinLrRatio": 0.03,
    "GradClip": 0.6,
    "WeightDecay": 0.08,
    "SaveEvery": 10000,
    "LatestEvery": 5000,
    "KeepLastN": 2,
    "EvalEvery": 5000,
    "EvalMaxBatches": 40,
    "Resume": "auto",
    "ResumeLrPolicy": "absolute",
    "StopCheckEvery": 10
  }
}
