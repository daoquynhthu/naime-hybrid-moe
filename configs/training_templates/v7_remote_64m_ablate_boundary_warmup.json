{
  "description": "Remote V7 64M-class ablation with boundary carry training plus conservative self-state warmup.",
  "params": {
    "Model": "naime_v7_typed_dynamics",
    "DataPath": "${remote.datasets}/fineweb_edu_50m",
    "OutputDir": "${remote.runs}",
    "RunName": "v7_64m_ablate_boundary_warmup_v1",
    "TargetTokens": 0,
    "TargetTokensMode": "total",
    "MaxSteps": 3000,
    "SeqLen": 512,
    "BatchSize": 4,
    "DModel": 384,
    "Layers": 8,
    "DenseLayers": 2,
    "Heads": 6,
    "KvHeads": 2,
    "Dff": 1536,
    "Dropout": 0.05,
    "Experts": 4,
    "TopK": 2,
    "ExpertHidden": 768,
    "MoeDispatchMode": "auto",
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 96,
    "WorldStateSlots": 4,
    "SelfStateSlots": 4,
    "LatentThoughtSteps": 1,
    "LatentThoughtWriteMode": "final_hidden",
    "LatentThoughtHiddenScale": 0.02,
    "StatefulBatchRatio": 0.10,
    "StatefulChunkLen": 256,
    "LambdaStatefulCarry": 0.0,
    "StatefulCarryMargin": 0.0,
    "StatefulBoundaryTokens": 64,
    "StatefulBoundaryDecay": 0.97,
    "LambdaStatefulBoundary": 0.002,
    "LambdaStatefulFull": 0.00025,
    "StatefulTargetMargin": 0.0,
    "SelfStateHiddenScaleWarmupSteps": 300,
    "SelfStateContextScoreWarmupSteps": 300,
    "SelfStateContextScoreStart": 1.0,
    "LatentFieldCoupling": true,
    "LatentFieldTokenScale": 0.02,
    "LatentFieldMaxRatio": 0.05,
    "V7DynamicsSteps": 1,
    "V7LatentSlots": 4,
    "V7LatentWriteScale": 0.03,
    "V7HiddenWriteScale": 0.05,
    "V7MaxHiddenWriteRatio": 0.10,
    "V7StateWriteScale": 0.03,
    "V7LatentTimescale": 1.0,
    "V7WorldTimescale": 1.0,
    "V7SelfTimescale": 1.0,
    "V7ControllerSlots": 1,
    "V7ControllerWriteScale": 0.02,
    "V7ControllerMode": "fixed",
    "V7PastLatentAdaptSteps": 1,
    "V7StateChunkSize": 128,
    "V7InternalLatentAdaptSteps": 0,
    "SemanticStateWriteScale": 0.075,
    "SemanticMemoryHiddenScale": 0.035,
    "WorldRouterMaxRatio": 0.10,
    "SemanticGateMixerMaxStateWeight": 0.38,
    "SelfStateWorldGateMin": 0.10,
    "SelfStateWorldGateScale": 1.0,
    "VramFraction": 0.90,
    "AutoBatchMax": 48,
    "NumWorkers": 0,
    "LmLossBackend": "cuda_ext_ce",
    "UseFusedStateAttention": true,
    "CompileModel": true,
    "CompileScope": "dense",
    "CompileBackend": "inductor",
    "LearningRate": 0.00012,
    "WarmupSteps": 300,
    "MinLrRatio": 0.05,
    "GradClip": 1.0,
    "WeightDecay": 0.05,
    "SaveEvery": 1500,
    "LatestEvery": 0,
    "KeepLastN": 2,
    "MetricsFlushEvery": 20,
    "MetricsFsyncEvery": 0,
    "BestCheckpointMode": "model",
    "EvalEvery": 500,
    "EvalMaxBatches": 20,
    "EvalStateCarry": true,
    "EvalV7DynamicsGain": true,
    "EvalV7StateSwap": true,
    "EvalV7StateErase": true,
    "EvalDocContinuity": true,
    "EvalDocContinuityDocs": 16,
    "EvalDocContinuityChunks": 3,
    "Resume": "none",
    "ResumeLrPolicy": "reset",
    "StopCheckEvery": 10
  }
}
