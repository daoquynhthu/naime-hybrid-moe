{
  "description": "Local V6 protocol smoke run. Small enough for quick architecture sanity checks.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${local.fineweb_edu_50m}",
    "OutputDir": "${local.run_root}",
    "TargetTokens": 12288000,
    "SeqLen": 512,
    "BatchSize": 4,
    "DModel": 384,
    "Layers": 8,
    "DenseLayers": 2,
    "Heads": 6,
    "KvHeads": 2,
    "Dff": 1536,
    "Experts": 4,
    "TopK": 2,
    "ExpertHidden": 768,
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 96,
    "SemanticStateWriteScale": 0.075,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "VramFraction": 0.80,
    "AutoBatchMax": 32,
    "NumWorkers": 0,
    "LearningRate": 0.00015,
    "WarmupSteps": 300,
    "MinLrRatio": 0.05,
    "GradClip": 1.0,
    "WeightDecay": 0.05,
    "SaveEvery": 0,
    "LatestEvery": 0,
    "EvalEvery": 500,
    "EvalMaxBatches": 10,
    "Resume": "none"
  }
}
