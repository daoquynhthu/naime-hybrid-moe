{
  "description": "Remote V7 typed-dynamics 100M-class validation run over 200M FineWeb-Edu tokens.",
  "params": {
    "Model": "naime_v7_typed_dynamics",
    "DataPath": "${remote.datasets}/fineweb_edu_1b_ctx1024",
    "OutputDir": "${remote.runs}",
    "RunName": "v7_100m_fineweb_200m_v3_dynamics_refactor",
    "TargetTokens": 200000000,
    "TargetTokensMode": "total",
    "SeqLen": 1024,
    "BatchSize": 4,
    "DModel": 384,
    "Layers": 10,
    "DenseLayers": 2,
    "Heads": 6,
    "KvHeads": 2,
    "Dff": 1536,
    "Dropout": 0.05,
    "Experts": 6,
    "TopK": 2,
    "ExpertHidden": 768,
    "MoeDispatchMode": "auto",
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 96,
    "WorldStateSlots": 4,
    "SelfStateSlots": 4,
    "LatentThoughtSteps": 1,
    "LatentThoughtWriteMode": "final_hidden",
    "LatentThoughtHiddenScale": 0.02,
    "StateEvolutionSteps": 1,
    "LatentFieldCoupling": true,
    "LatentFieldTokenScale": 0.02,
    "LatentFieldMaxRatio": 0.05,
    "V7DynamicsSteps": 2,
    "V7LatentSlots": 4,
    "V7LatentWriteScale": 0.03,
    "V7HiddenWriteScale": 0.035,
    "V7MaxHiddenWriteRatio": 0.08,
    "V7StateWriteScale": 0.03,
    "V7LatentTimescale": 1.0,
    "V7WorldTimescale": 1.0,
    "V7SelfTimescale": 1.0,
    "V7ControllerSlots": 1,
    "V7ControllerWriteScale": 0.02,
    "V7ControllerMode": "fixed",
    "V7PastLatentAdaptSteps": 2,
    "V7StateChunkSize": 256,
    "V7InternalLatentAdaptSteps": 0,
    "V7HomeostaticControl": true,
    "V7HomeostaticStrength": 0.25,
    "V7HomeostaticMinScale": 0.70,
    "V7HomeostaticMaxScale": 1.20,
    "V7StateCompatibilityGate": true,
    "V7StateCompatibilityStrength": 1.0,
    "V7StateCompatibilityMin": 0.15,
    "V7AdaptiveTau": true,
    "V7AdaptiveTauMin": 0.65,
    "V7AdaptiveTauMax": 1.25,
    "V7CausalSummaryDecay": 0.98,
    "SemanticStateWriteScale": 0.075,
    "SemanticMemoryHiddenScale": 0.035,
    "WorldRouterMaxRatio": 0.10,
    "WorldRouterMode": "modulate",
    "WorldRouterModulationScale": 0.35,
    "SemanticGateMixerMaxStateWeight": 0.38,
    "SelfStateWorldGateMin": 0.10,
    "SelfStateWorldGateScale": 1.0,
    "VramFraction": 0.90,
    "AutoBatchMax": 32,
    "NumWorkers": 0,
    "LmLossBackend": "cuda_ext_ce",
    "UseFusedStateAttention": true,
    "CompileModel": false,
    "CompileScope": "dense",
    "CompileBackend": "inductor",
    "LearningRate": 0.00008,
    "WarmupSteps": 800,
    "MinLrRatio": 0.06,
    "GradClip": 0.8,
    "WeightDecay": 0.08,
    "SaveEvery": 5000,
    "LatestEvery": 0,
    "KeepLastN": 2,
    "MetricsFlushEvery": 50,
    "MetricsFsyncEvery": 1000,
    "BestCheckpointMode": "model",
    "EvalEvery": 2000,
    "EvalMaxBatches": 30,
    "EvalStateCarry": true,
    "EvalLatentThoughtGain": true,
    "EvalV7DynamicsGain": true,
    "EvalV7StateSwap": true,
    "EvalV7StateErase": true,
    "Resume": "none",
    "ResumeLrPolicy": "reset",
    "StopCheckEvery": 10
  }
}
