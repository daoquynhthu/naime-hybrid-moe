{
  "description": "Local 64M-class V6 probe for checking architecture metrics before remote training.",
  "params": {
    "Model": "naime_v6_recursive_self_moe",
    "DataPath": "${local.fineweb_edu_50m}",
    "OutputDir": "${local.run_root}",
    "TargetTokens": 50000000,
    "SeqLen": 1024,
    "BatchSize": 4,
    "DModel": 640,
    "Layers": 10,
    "DenseLayers": 2,
    "Heads": 10,
    "KvHeads": 2,
    "Dff": 2560,
    "Experts": 6,
    "TopK": 2,
    "ExpertHidden": 1280,
    "Stride": 16,
    "CausalStateStride": 512,
    "Window": 24,
    "ZDim": 160,
    "WorldStateSlots": 6,
    "SelfStateSlots": 6,
    "SemanticStateWriteScale": 0.075,
    "SemanticGateMixerMaxStateWeight": 0.35,
    "SelfStateWorldGateMin": 0.10,
    "VramFraction": 0.80,
    "AutoBatchMax": 32,
    "NumWorkers": 0,
    "LearningRate": 0.00004,
    "WarmupSteps": 600,
    "MinLrRatio": 0.05,
    "GradClip": 1.0,
    "WeightDecay": 0.06,
    "SaveEvery": 5000,
    "LatestEvery": 2500,
    "EvalEvery": 2500,
    "EvalMaxBatches": 20,
    "Resume": "none"
  }
}
